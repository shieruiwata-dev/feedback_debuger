# ===========================================================================
# Edge Functions 用の環境変数
#   本番では supabase secrets set で設定する:
#     supabase secrets set --env-file .env
#   （SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY は Supabase が自動注入するので不要）
# ===========================================================================

# --- Slack -----------------------------------------------------------------
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-

# --- AI エンリッチメント -----------------------------------------------------
# 実装順序 Step 2〜4 の間は false。Step 6 で true にする
ENABLE_AI_ENRICHMENT=false

DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_CLASSIFY_API_KEY=app-
DIFY_TIMEOUT_MS=30000

# --- クラスタリング方式 -------------------------------------------------------
#   llm       … 既存クラスタの要約一覧を LLM に見せて同じ論点かを判断させる。
#               埋め込み API が無い環境向け。照合は分類と同じ Dify 呼び出しに同居する
#   embedding … 要約をベクトル化し pgvector の最近傍で決める（OPENAI_API_KEY が必要）
# 未設定の場合、OPENAI_API_KEY があれば embedding、無ければ llm
CLUSTERING_STRATEGY=llm
# LLM に見せる候補クラスタの上限。増やすと精度が上がるがプロンプトが膨らむ
LLM_CLUSTER_CANDIDATES=40

# 以下は CLUSTERING_STRATEGY=embedding のときだけ使う
# クラスタリングに使うベクトルの元。
#   summary  … 要約（既定）。言い回しの違いを吸収して同じ内容をまとめやすい
#   raw_text … 原文。要約の取り違えに引きずられたくない場合
EMBEDDING_SOURCE=summary
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# --- フィードバック選別（ノイズ除去） -----------------------------------------
# 層 0: insert 前に定型ノイズを破棄する（相槌・URL だけ・絵文字だけ）
ENABLE_PREINSERT_NOISE_FILTER=true
NOISE_MIN_LENGTH=6
# 自動通知の定型文を落とす正規表現をカンマ区切りで（例: '^\[Deploy\],^Build #\d+'）
NOISE_PATTERNS=

# 層 1: Dify の is_feedback 判定でノイズを status='ignored' に落とす
ENABLE_AI_TRIAGE=true
AI_TRIAGE_SOURCE_TYPES=slack
# app_settings の triage.min_confidence が優先。これはフォールバック値
AI_TRIAGE_MIN_CONFIDENCE=0.7

# 層 2: 人が明示する経路（本文マークと絵文字リアクション）
SLACK_FEEDBACK_MARKERS=#fb,#feedback,#フィードバック,#要望,#不具合
SLACK_FEEDBACK_REACTIONS=inbox_tray,memo,mega

# --- フォーム ----------------------------------------------------------------
# ウィジェットを設置する自社サイトのオリジンをカンマ区切りで。本番では必ず設定する
FORM_ALLOWED_ORIGINS=
FORM_RATE_LIMIT_SHORT_MAX=5
FORM_RATE_LIMIT_SHORT_WINDOW_SEC=60
FORM_RATE_LIMIT_LONG_MAX=30
FORM_RATE_LIMIT_LONG_WINDOW_SEC=3600

# CAPTCHA は未導入。設定した場合のみ検証が有効になる (turnstile / recaptcha)
CAPTCHA_PROVIDER=
CAPTCHA_SECRET_KEY=

# --- 再処理 ------------------------------------------------------------------
REPROCESS_BATCH_SIZE=20
